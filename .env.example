# Generated host identity. Use `sh ./compose-setup.sh ...` instead of editing these.
HERMES_UID=1000
HERMES_GID=1000
HQUOTA_RUNTIME_DIR=/absolute/path/to/hquota/run/hquota
HERMES_DATA_DIR=/home/user/.hermes

# Credential locations on the host.
CODEX_BUSINESS_HOME=/home/user/.codex-business
CODEX_PERSONAL_HOME=/home/user/.codex-personal
COMMAND_CODE_KEY_FILE=/home/user/.config/command-code/api-key

# Stable local image names. hermes-stack can reference these directly.
HQUOTA_BROKER_IMAGE=hquota-broker:local
HERMES_HQUOTA_IMAGE=hermes-hquota:local
HQUOTA_CONTAINER_NAME=hermes-hquota

# Override when the Hermes image must extend an existing local base image.
HERMES_BASE_IMAGE=nousresearch/hermes-agent:latest
