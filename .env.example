# Generated host identity. Use `sh ./compose-setup.sh ...` instead of editing these.
HERMES_UID=1000
HERMES_GID=1000

# Credential locations on the host.
CODEX_BUSINESS_HOME=/home/user/.codex-business
CODEX_PERSONAL_HOME=/home/user/.codex-personal
COMMAND_CODE_KEY_FILE=/home/user/.config/command-code/api-key

# Only change this when the Hermes image must extend an existing local base image.
HERMES_BASE_IMAGE=nousresearch/hermes-agent:latest
